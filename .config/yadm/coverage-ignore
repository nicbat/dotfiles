# Patterns for yadm-coverage. One glob per line, matched against paths
# relative to $HOME. Anything matching here is never reported as a gap.
#
# Three kinds of thing belong in this file:
#   1. application state that merely lives in ~/.config
#   2. files Noctalia generates from the wallpaper palette
#   3. secrets, which must never enter a public repo
# Everything else should either be tracked or listed here with a reason.

# ── 1. application state, not configuration ──────────────────────────
.config/Antigravity/*
.config/Bitwarden/*
.config/BraveSoftware/*
.config/Claude/*
.config/Cursor/*
.config/Google/*
.config/Notion/*
.config/Signal/*
.config/Todoist/*
.config/cheat/*
.config/chromium/*
.config/cursor/*
.config/dconf/*
.config/discord/*
.config/go/*
.config/google-chrome/*
.config/microsoft-edge/*
.config/notion-calendar-electron/*
.config/obsidian/*
.config/opera/*
.config/pulse/*
.config/spotify/*
.config/vivaldi/*
.config/zoom/*
.config/create-next-app-nodejs
.config/nextjs-nodejs
.config/pavucontrol.ini
.config/QtProject.conf
.config/user-dirs.locale
.config/zoom.conf
.config/zoomus.conf

# ── 2. generated by Noctalia from the wallpaper palette ──────────────
# Tracking any of these means a diff every time the wallpaper changes.
.config/gtk-3.0/*
.config/gtk-4.0/*
.config/qt5ct/colors/*
.config/qt6ct/colors/*
.config/kitty/themes/*
.config/ghostty/themes/*
.config/btop/themes/*
.config/yazi/flavors/*
.config/zed/themes/*
.config/zathura/noctaliarc
.config/spicetify/Themes/*/color.ini
.config/nvim/lua/matugen.lua

# ── 3. secrets - must never reach a public repo ──────────────────────
.config/gh/hosts.yml
.npmrc
.ssh/*
.gnupg/*
.netrc

# ── housekeeping ─────────────────────────────────────────────────────
*.pre-phases
*.pre-appendpath-fix
*.pre-dialogs
*.pre-cwd-fix
*.pre-awww-removal
.config/nvim.bak/*

# ── more application state (found by the first coverage run) ─────────
.config/Android Open Source Project/*
.config/Code Industry/*
.config/Notion Calendar/*
.config/etest/*
.config/herdr/*
.config/ibus/*
.config/io.github.CyberTimon.RapidRAW/*
.config/mozc/*
.config/fcitx/*
.config/yay/*
.config/todoist/*
.config/systemd/*
.config/*/.claude/*
.config/fcitx5/conf/cached_layouts

# Shell/editor history and machine-local tokens.
.bash_history
.bash_logout
.lesshst
.viminfo
.pulse-cookie
.claude.json
.claude.json.tmp.*
.emulator_console_auth_token
.yarnrc

# Generated by Noctalia (palette state, not settings).
.config/noctalia/colors.json

# Retired subsystems - see the changelog. Left on disk, not worth restoring.
.config/foot/*
.config/waybar/*

# Backups, mine and the tools'.
*.bak
*.bak-*
*.pre-*
.config/ghostty/config.ghostty

# ── vendored / reinstallable, not authored ───────────────────────────
# Spicetify marketplace apps and the Comfy theme are downloaded artifacts;
# `spicetify-noctalia-link` (tracked, in ~/.local/bin) rebuilds the Noctalia
# wiring, and spicetify reinstalls the rest. Sleek/user.css IS tracked - it
# has local modifications, confirmed against its own .orig.
.config/spicetify/CustomApps/*
.config/spicetify/Themes/Comfy/*
*.orig
.config/logid/README.md

# mako is not running - Noctalia owns notifications now.
.config/mako/*

# Tool state.
.config/.claude/*
.config/create-next-app-nodejs/*
.config/nextjs-nodejs/*
.config/spicetify/Themes/Sleek/README.md
