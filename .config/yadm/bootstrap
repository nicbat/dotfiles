#!/usr/bin/env bash
# yadm bootstrap - rebuild this machine from a fresh Arch install.
#
#   pacman -S --needed git yadm
#   yadm clone git@github.com:nicbat/dotfiles.git
#   yadm bootstrap
#
# Safe to re-run: every step is idempotent.

set -uo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/yadm"
say() { printf '\n\033[1;35m==>\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$1"; }

# ── 1. AUR helper ────────────────────────────────────────────────────
if ! command -v yay >/dev/null 2>&1; then
  say "Installing yay"
  sudo pacman -S --needed --noconfirm base-devel git
  tmp=$(mktemp -d)
  git clone https://aur.archlinux.org/yay.git "$tmp/yay"
  (cd "$tmp/yay" && makepkg -si --noconfirm)
  rm -rf "$tmp"
fi

# ── 2. Packages ──────────────────────────────────────────────────────
if [[ -f "$CFG/packages-pacman.txt" ]]; then
  say "Installing repo packages"
  sudo pacman -S --needed --noconfirm - < "$CFG/packages-pacman.txt"
fi

if [[ -f "$CFG/packages-aur.txt" ]]; then
  say "Installing AUR packages"
  # One at a time: a single unbuildable AUR package shouldn't abort the rest.
  while read -r pkg; do
    [[ -z "$pkg" ]] && continue
    yay -S --needed --noconfirm "$pkg" || warn "AUR package failed, skipping: $pkg"
  done < "$CFG/packages-aur.txt"
fi

# ── 3. Services ──────────────────────────────────────────────────────
say "Enabling services"
sudo systemctl enable --now power-profiles-daemon thermald 2>/dev/null || warn "service enable failed"
sudo systemctl enable sddm 2>/dev/null || warn "sddm enable failed"

# Keeps a headless ghostty instance warm from login, so the first Mod+T is an
# IPC call (~0.1s) rather than a cold GTK/font/GL start (~0.6s+). The unit ships
# with the ghostty package and runs it with --initial-window=false.
systemctl --user enable app-com.mitchellh.ghostty.service 2>/dev/null \
  || warn "ghostty user service enable failed"

# ── 3b. Git clean filters ────────────────────────────────────────────
# ~/.gitattributes points two files at clean filters, but filter DEFINITIONS
# are repo-local git config and do not survive a clone. Without this step git
# silently ignores the attributes and the noise comes straight back.
say "Registering yadm clean filters"
yadm gitconfig filter.json-canonical.clean "$CFG/filters/json-canonical"
yadm gitconfig filter.starship-clean.clean "$CFG/filters/starship-clean"

# Put the coverage checker on PATH.
mkdir -p "$HOME/.local/bin"
ln -sf "$CFG/yadm-coverage" "$HOME/.local/bin/yadm-coverage"

# ── 4. Desktop appearance ────────────────────────────────────────────
# Colours are generated by Noctalia from the wallpaper, so they are NOT set
# here. Only the palette-independent bits (icons, cursor, fonts) are pinned.
say "Setting icon/cursor/font defaults"
gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'
gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Ice'
gsettings set org.gnome.desktop.interface cursor-size 24
gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrainsMono Nerd Font 11'
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'

# ── 5. Manual follow-ups ─────────────────────────────────────────────
cat <<'EOF'

────────────────────────────────────────────────────────────────
Bootstrap done. Remaining manual steps:

  1. Wallpapers are not in this repo (too large). Restore
     ~/Pictures/Backgrounds, then pick one in Noctalia - that is
     what generates the whole colour scheme.

  2. Drop an avatar at ~/.face for Noctalia's lock screen.

  3. Log into niri. Noctalia starts from niri's config and will
     regenerate every themed config on first wallpaper set:
     GTK3/4, Qt (qt6ct), kitty, ghostty, btop, yazi, zathura,
     starship, zed, steam, vicinae, and the nvim base16 template.

  4. Monitor layout in config.kdl is matched by make/model/serial,
     so the two Lenovo P27h externals should re-detect on their own.
     If not, run wdisplays and re-save the positions.

  5. This machine's firmware drops UEFI NVRAM boot entries. Verify
     the fallback bootloader is installed before you trust it.

  6. Run `yadm-coverage` to see any config this repo does not yet
     track. yadm cannot tell you this itself - its work-tree is
     $HOME, so "untracked" means ~650k files and status has to
     suppress it.
────────────────────────────────────────────────────────────────
EOF
