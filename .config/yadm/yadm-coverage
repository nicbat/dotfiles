#!/usr/bin/env bash
# yadm-coverage - answer the question yadm structurally cannot.
#
# yadm's work-tree is $HOME, so "untracked" means every file you own
# (~650k of them). status.showUntrackedFiles has to be "no" or the tool is
# unusable - which means a config file you create is invisible to
# `yadm status` forever. Nothing warns you; it just never gets backed up.
#
# This walks where configuration actually lives, subtracts what yadm tracks,
# subtracts ~/.config/yadm/coverage-ignore, and prints the remainder.
# Anything printed is either worth tracking or worth an ignore pattern.
#
#   yadm-coverage          list untracked config
#   yadm-coverage -a       track everything listed (runs `yadm add`)
#
# Ignore patterns ending in /* also prune that directory during the walk,
# so Electron app trees cost nothing to skip.

set -uo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/yadm"
IGNORE="$CFG/coverage-ignore"
add_mode=false
[[ ${1:-} == "-a" ]] && add_mode=true

cd "$HOME" || exit 1

tracked=$(yadm ls-files 2>/dev/null | sort -u)
mapfile -t patterns < <(grep -vE '^\s*#|^\s*$' "$IGNORE" 2>/dev/null)

# Directories to skip entirely: any pattern of the form some/dir/*
prune=()
for p in "${patterns[@]}"; do
  [[ $p == */\* ]] && prune+=(-path "./${p%/\*}" -prune -o)
done

# Depth 6 under .config so nvim/lua/plugins/*.lua is reached; the prune list
# keeps that from turning into a walk of every browser profile on the disk.
candidates=$(
  {
    find ./.config "${prune[@]}" -maxdepth 6 -type f -print 2>/dev/null
    find ./.local/bin -maxdepth 1 -type f -print 2>/dev/null
    find . -maxdepth 1 -type f -name '.*' -print 2>/dev/null
  } | sed 's|^\./||' | sort -u
)

ignored() {
  local f=$1 p
  for p in "${patterns[@]}"; do
    # shellcheck disable=SC2053
    [[ $f == $p ]] && return 0
  done
  return 1
}

gaps=()
while IFS= read -r f; do
  [[ -z $f ]] && continue
  grep -qxF "$f" <<<"$tracked" && continue
  ignored "$f" && continue
  gaps+=("$f")
done <<<"$candidates"

if $add_mode; then
  # Add directly rather than printing a line to eval: several paths under
  # ~/.config contain spaces, and a printed command word-splits on them.
  if [[ ${#gaps[@]} -eq 0 ]]; then
    echo "Nothing to add."
  else
    yadm add -- "${gaps[@]}" && printf 'Tracked %d file(s).\n' "${#gaps[@]}"
  fi
  exit 0
fi

n_tracked=$(grep -c . <<<"$tracked")
if [[ ${#gaps[@]} -eq 0 ]]; then
  printf '\033[1;32mAll covered.\033[0m %s files tracked, no gaps.\n' "$n_tracked"
  exit 0
fi

printf '\033[1;33m%d untracked config file(s)\033[0m (%s tracked)\n\n' "${#gaps[@]}" "$n_tracked"
printf '  %s\n' "${gaps[@]}"
printf '\nTrack them all:  yadm-coverage -a\n'
printf 'Or silence one:  add a pattern to %s\n' "${IGNORE/#$HOME/\~}"
