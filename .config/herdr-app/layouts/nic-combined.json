{
  "id": "root",
  "terminal_menu": "nic-menu",
  "preview": "layouts/nic-combined.svg",
  "cloned_from": {
    "name": "main",
    "version": "0.1.9"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-sections",
          "type": "column",
          "resizable": true,
          "divider": { "width": 1, "color": "border" },
          "children": [
            {
              "id": "workspace-section",
              "type": "column",
              "size": { "weight": 3 },
              "min": 30,
              "resizable": false,
              "children": [
                {
                  "id": "workspace-section-header",
                  "type": "block",
                  "size": { "px": 30 },
                  "content": {
                    "mod": "nic-sidebar-section",
                    "props": {
                      "section": "workspace-section", "body": "sidebar-lists", "parent": "sidebar-sections",
                      "title": "Workspaces", "count": "nic.sidebar.workspaces-count", "suffix": "agents",
                      "activity": "nic.sidebar.agent-counts",
                      "action": "space.new", "actionTitle": "New space"
                    }
                  }
                },
                {
                  "id": "sidebar-lists",
                  "type": "block",
                  "content": { "mod": "nic-workspaces", "props": { "hideHeader": true, "section": "workspace-section" } }
                }
              ]
            },
            {
              "id": "todo-section",
              "type": "column",
              "size": { "weight": 1 },
              "min": 30,
              "resizable": false,
              "children": [
                {
                  "id": "todo-section-header",
                  "type": "block",
                  "size": { "px": 30 },
                  "content": {
                    "mod": "nic-sidebar-section",
                    "props": {
                      "section": "todo-section", "body": "todo-list", "parent": "sidebar-sections",
                      "title": "Todo", "count": "nic.sidebar.todo-count", "suffix": "open"
                    }
                  }
                },
                {
                  "id": "todo-list",
                  "type": "block",
                  "content": { "mod": "nic-todo", "props": { "section": "todo-section" } }
                }
              ]
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "nic-auto-title"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "nic-workspace-status",
            "props": { "hideAgents": true }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
